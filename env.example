SECRET_KEY=django-insecure-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEBUG=True

ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1,lk.example.com

DB_NAME=example_db
DB_USER=example_user
DB_PASSWORD=example_password
DB_HOST=localhost
DB_PORT=5432
DB_WAIT_TIMEOUT=60

DEPLOY_PROJECT_DIR=/var/www/Project
DEPLOY_BRANCH=main
DEPLOY_PROJECT_NAME=Django-FastStart
DEPLOY_HEALTH_URL=http://127.0.0.1:8000/api/v1/health/
DEPLOY_STARTUP_DELAY=10
DEPLOY_HEALTHCHECK_ATTEMPTS=10
DEPLOY_HEALTHCHECK_DELAY=3
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=

CORS_ALLOWED_ORIGINS=https://lk.example.com,https://api.example.com,http://localhost:3000,https://frontend.example.com
CORS_ALLOW_ALL_ORIGINS=False

CSRF_TRUSTED_ORIGINS=https://api.example.com,https://lk.example.com,http://localhost:3000,https://frontend.example.com
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_SAMESITE=None
CSRF_COOKIE_HTTPONLY=False
CSRF_COOKIE_DOMAIN=.example.com

SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_HTTPONLY=False
SESSION_COOKIE_DOMAIN=.example.com

EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=
FRONTEND_URL=http://127.0.0.1:3000

# Логирование (относительные пути — от корня проекта)
# LOG_LEVEL: DEBUG при DEBUG=True, иначе INFO
# LOG_LEVEL=INFO
LOG_CONSOLE=True
LOG_CONSOLE_FORMAT=text
LOG_FILE_TEXT=True
LOG_FILE_TEXT_PATH=logs/app.log
LOG_FILE_TEXT_ERROR_PATH=logs/error.log
LOG_FILE_JSON=True
LOG_FILE_JSON_PATH=logs/app.json.log
LOG_FILE_JSON_ERROR_PATH=logs/error.json.log
LOG_ROTATION_WHEN=midnight
LOG_ROTATION_INTERVAL=1
LOG_ROTATION_BACKUP=14
LOG_ROTATION_UTC=False
